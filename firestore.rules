rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isNotPendingDeletion(uid) {
      return !exists(/databases/$(database)/documents/deleted_users/$(uid));
    }

    function isGlobalAdmin() {
      return isAuth() &&
             isActiveSession(request.auth.uid) &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings).data.get('isAdmin', false) == true;
    }

    function isActiveSession(uid) {
      return isAuth() &&
             request.auth.uid == uid &&
             'activeSessionId' in request.auth.token &&
             request.auth.token.activeSessionId != null &&
             request.auth.token.activeSessionId != '' &&
             exists(/databases/$(database)/documents/users/$(uid)/private/settings) &&
             get(/databases/$(database)/documents/users/$(uid)/private/settings).data.get('activeSessionId', '') == request.auth.token.activeSessionId;
    }

    function isArtifactOwner(artifactId) {
      return isAuth() &&
             exists(/databases/$(database)/documents/artifacts/$(artifactId)) &&
             get(/databases/$(database)/documents/artifacts/$(artifactId)).data.get('userId', '') == request.auth.uid;
    }

    function canReadArtifact(artifactId) {
      let path = /databases/$(database)/documents/artifacts/$(artifactId);
      return exists(path) && (
        get(path).data.get('isPublic', false) == true ||
        (isAuth() && get(path).data.get('userId', '') == request.auth.uid && isActiveSession(request.auth.uid)) ||
        isGlobalAdmin()
      );
    }

    function canReadResonators(artifactId) {
      let path = /databases/$(database)/documents/artifacts/$(artifactId);
      return canReadArtifact(artifactId) && (
        get(path).data.get('reactionVisibility', 'APPROXIMATE') in ['VISIBLE', 'APPROXIMATE']
      );
    }

    function getCurrentAnonymousId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('anonymousId', '');
    }

    function isCommentUnlocked(uid, artifactId) {
      let path = /databases/$(database)/documents/users/$(uid)/engagement/$(artifactId);
      return exists(path) && get(path).data.get('isCommentUnlocked', false) == true;
    }

    function backendFields() {
      return ['isCommentUnlocked', 'unlockTimestamp', 'unlockReason', 'engagementState', 'reprocessRequestedAt'];
    }

    function isPublishingEnabled() {
      let configPath = /databases/$(database)/documents/system/config;
      return exists(configPath) &&
             get(configPath).data.get('publishingEnabled', false) == true;
    }

    function getIdentityMetadata(data) {
      return data.get('identityMetadata', {});
    }

    function isValidIdentityUpdate(oldData, newData) {
      let oldMeta = getIdentityMetadata(oldData);
      let newMeta = getIdentityMetadata(newData);

      let oldV = oldMeta.get('identityResetVersion', 0);
      let newV = newMeta.get('identityResetVersion', 0);
      let oldC = oldMeta.get('lastCompletedIdentityVersion', 0);
      let newC = newMeta.get('lastCompletedIdentityVersion', 0);
      let oldR = oldMeta.get('emergencyResetCount', 0);
      let newR = newMeta.get('emergencyResetCount', 0);

      return newV >= oldV &&
             newC >= oldC &&
             newC <= newV &&
             newR >= oldR;
    }

    function isCreationStatusValid(data) {
      let status = data.get('status', 'PENDING_UPLOAD');
      let audioUrl = data.get('audioUrl', '');
      return (status in ['PENDING_UPLOAD', 'DRAFT'] && audioUrl == '') ||
             (status == 'ACTIVE' && audioUrl != '');
    }

    function isCreationFieldsValid(data) {
      return data.get('playCount', 0) == 0 &&
             data.get('reactionCount', 0) == 0 &&
             data.get('commentCount', 0) == 0 &&
             data.get('reportCount', 0) == 0 &&
             data.get('savedCount', 0) == 0 &&
             data.get('status', '') in ['ACTIVE', 'PENDING_UPLOAD', 'DRAFT'] &&
             data.get('isDraft', true) == (data.get('status', '') in ['PENDING_UPLOAD', 'DRAFT']);
    }

    function isValidLifecycleTransition(oldData, newData) {
      let oldStatus = oldData.get('status', 'PENDING_UPLOAD');
      let newStatus = newData.get('status', 'PENDING_UPLOAD');
      return (oldStatus == newStatus) ||
             (oldStatus in ['PENDING_UPLOAD', 'DRAFT'] && newStatus == 'ACTIVE') ||
             (newStatus == 'DELETED');
    }

    // --- USERS & PROFILES ---
    match /users/{uid} {
      allow read: if isOwner(uid) && isActiveSession(uid);

      allow create: if isOwner(uid) &&
                    isNotPendingDeletion(uid) &&
                    request.resource.data.keys().hasOnly([
                      'anonymousId', 'anonymousName', 'anonymousSigil', 'sigilSeed',
                      'sigilColor', 'sigilConfig', 'createdAt', 'identityMetadata',
                      'avatarConfig', 'resonanceInCount', 'resonanceOutCount',
                      'followersCount', 'followingCount'
                    ]) &&
                    !("isAdmin" in request.resource.data) &&
                    !("admin" in request.resource.data) &&
                    !("accountStatus" in request.resource.data);

      allow update: if resource != null &&
                    isOwner(uid) &&
                    isNotPendingDeletion(uid) &&
                    isActiveSession(uid) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'isAdmin', 'admin', 'accountStatus', 'email', 'realName', 'fcmToken',
                      'emotionPreferences', 'lastActivityTimestamp', 'softStreakCount', 'lastSeen',
                      'resonanceInCount', 'resonanceOutCount', 'followersCount', 'followingCount'
                    ]) &&
                    isValidIdentityUpdate(resource.data, request.resource.data);

      allow delete: if false;

      // --- PRIVATE SUBCOLLECTIONS (Explicit Match Blocks Only - No Loose Wildcards) ---

      // Settings
      match /private/settings {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
                         isNotPendingDeletion(uid) &&
                         request.resource.data.get('isAdmin', false) == false &&
                         request.resource.data.get('accountStatus', 'ACTIVE') == 'ACTIVE' &&
                         !('activeSessionId' in request.resource.data) &&
                         !('lastTransferCorrelationId' in request.resource.data);
        allow update: if isOwner(uid) && (
                         (isNotPendingDeletion(uid) &&
                          isActiveSession(uid) &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'isAdmin', 'accountStatus', 'admin',
                            'activeSessionId', 'activeSessionCreatedAt', 'activeSessionUpdatedAt',
                            'lastTransferCorrelationId', 'lastTransferTimestamp'
                          ])) ||
                         ((exists(/databases/$(database)/documents/deleted_users/$(uid)) ||
                           existsAfter(/databases/$(database)/documents/deleted_users/$(uid))) &&
                          (!('activeSessionId' in request.resource.data) ||
                           request.resource.data.activeSessionId == null ||
                           request.resource.data.activeSessionId == ''))
                       );
        allow delete: if false;
      }

      // Reports suppression markers (Server-managed only)
      match /private/reports/{reportDoc=**} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      // Ignored Users
      match /private/ignored_users/users/{targetId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Migration Audit (Server-only)
      match /migration_audit/{docId} {
        allow read, write: if false;
      }

      // Published Artifacts Reservation Registry (Server-managed only via preparePublish)
      match /private/published_artifacts/{doc=**} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      // Interactions (Pulse / local interaction cache)
      match /private/interactions/{doc=**} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Sequence counter (Server-managed only via preparePublish)
      match /private/sequence {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      // Consumed Prompts
      match /private/consumed_prompts/{promptId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Identity History
      match /private/identity_history/{doc=**} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      // Other explicit private documents
      match /private/metadata {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Private Suppressions (Not for Me)
      match /private/suppressions/artifacts/{artifactId} {
        allow read: if isOwner(uid) && isActiveSession(uid);

        allow create, update: if isOwner(uid) &&
                                 isNotPendingDeletion(uid) &&
                                 isActiveSession(uid) &&
                                 request.resource.data.userId == uid &&
                                 request.resource.data.artifactId == artifactId &&
                                 request.resource.data.type == 'NOT_FOR_ME' &&
                                 request.resource.data.suppressedAt is timestamp &&
                                 request.resource.data.keys().hasOnly(['userId', 'artifactId', 'suppressedAt', 'type']) &&
                                 request.resource.data.keys().hasAll(['userId', 'artifactId', 'suppressedAt', 'type']);

        allow delete: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Resonance
      match /resonance_in/{targetId} { allow read: if isOwner(uid) && isActiveSession(uid); allow write: if false; }
      match /resonance_out/{targetId} { allow read: if isOwner(uid) && isActiveSession(uid); allow write: if false; }
      match /followers/{targetId} { allow read: if isOwner(uid) && isActiveSession(uid); allow write: if false; }
      match /following/{targetId} { allow read: if isOwner(uid) && isActiveSession(uid); allow write: if false; }

      // Canonical Relationships
      match /relationships/{targetId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      match /relationships/{targetId}/operations/{operationId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if false;
      }

      // Saved Artifacts
      match /savedArtifacts/{artifactId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Interaction Counters
      match /counters/{artifactId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      // Engagement
      match /engagement/{artifactId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow create: if isOwner(uid) &&
                      isNotPendingDeletion(uid) &&
                      isActiveSession(uid) &&
                      !(request.resource.data.keys().hasAny(backendFields()));
        allow update: if isOwner(uid) &&
                      isNotPendingDeletion(uid) &&
                      isActiveSession(uid) &&
                      !(request.resource.data.diff(resource.data).affectedKeys().hasAny(backendFields()));
        allow delete: if false;
      }

      // Abuse Protected Intents
      match /private/intents/follow/{targetAnonId} {
        allow read: if isOwner(uid) && isActiveSession(uid);
        allow write: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      match /private/intents/reactions/{artifactId} {
        allow create: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid) && !isArtifactOwner(artifactId);
        allow update, delete: if isOwner(uid) && isNotPendingDeletion(uid) && isActiveSession(uid);
      }

      match /private/intents/comments/{commentId} {
        allow get: if isOwner(uid) && isActiveSession(uid);
        allow list: if false;

        allow create: if isOwner(uid) &&
                      isNotPendingDeletion(uid) &&
                      isActiveSession(uid) &&
                      'artifactId' in request.resource.data &&
                      request.resource.data.artifactId is string &&
                      'text' in request.resource.data &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() >= 1 &&
                      request.resource.data.text.size() <= 1000 &&
                      (!('status' in request.resource.data) ||
                       request.resource.data.status == 'PENDING') &&
                      request.resource.data.keys().hasOnly([
                        'artifactId',
                        'text',
                        'authorAnonymousId',
                        'author',
                        'identityVersion',
                        'identityPropagationVersion',
                        'status'
                      ]) &&
                      (
                        isArtifactOwner(request.resource.data.artifactId) ||
                        isCommentUnlocked(uid, request.resource.data.artifactId)
                      );

        allow update: if isOwner(uid) &&
                      isNotPendingDeletion(uid) &&
                      isActiveSession(uid) &&
                      resource.data.get('status', '') == 'RATE_LIMITED' &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['clientRetryRequestedAt']) &&
                      'clientRetryRequestedAt' in request.resource.data &&
                      (
                        request.resource.data.clientRetryRequestedAt is int ||
                        request.resource.data.clientRetryRequestedAt is float
                      ) &&
                      (
                        !('clientRetryRequestedAt' in resource.data) ||
                        request.resource.data.clientRetryRequestedAt >
                          resource.data.clientRetryRequestedAt
                      ) &&
                      (
                        !('lastConsumedRetryAt' in resource.data) ||
                        request.resource.data.clientRetryRequestedAt >
                          resource.data.lastConsumedRetryAt
                      ) &&
                      request.resource.data.clientRetryRequestedAt <=
                        request.time.toMillis();

        allow delete: if false;
      }
    }

    // --- ARTIFACTS (The Hearth) ---
    match /artifacts/{artifactId} {
      allow read: if resource.data.isPublic == true ||
                    (isAuth() && resource.data.userId == request.auth.uid && isActiveSession(request.auth.uid)) ||
                    isGlobalAdmin();

      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isPublishingEnabled() &&
                    isActiveSession(request.auth.uid) &&
                    request.resource.data.get('userId', '') == request.auth.uid &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/published_artifacts/artifacts/$(artifactId)) &&
                    request.resource.data.author.anonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId &&
                    request.resource.data.author.keys().hasAll(['anonymousId', 'name']) &&
                    request.resource.data.get('identityVersion', 0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityMetadata.get('identityResetVersion', 0) &&
                    request.resource.data.get('identityPropagationVersion', 0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityMetadata.get('identityResetVersion', 0) &&
                    isCreationStatusValid(request.resource.data) &&
                    isCreationFieldsValid(request.resource.data) &&
                    request.resource.data.keys().hasOnly([
                      'userId', 'author', 'title', 'description', 'emotion', 'emotions',
                      'primaryEmotion', 'primaryStyle', 'durationMs', 'audioUrl', 'transcriptUrl',
                      'status', 'isDraft', 'isPublic', 'createdAt', 'updatedAt', 'episodeNumber',
                      'identityVersion', 'identityPropagationVersion', 'reactionVisibility',
                      'amplitudeData', 'playCount', 'qualifiedPlayCount', 'reactionCount',
                      'commentCount', 'reportCount', 'savedCount', 'recommendationState', 'moderation'
                    ]);

      allow update: if isGlobalAdmin() ||
                    (resource != null &&
                     isArtifactOwner(artifactId) &&
                     isNotPendingDeletion(request.auth.uid) &&
                     isActiveSession(request.auth.uid) &&
                     isValidLifecycleTransition(resource.data, request.resource.data) &&
                     request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
                     (resource.data.status != 'ACTIVE' || resource.data.audioUrl == request.resource.data.audioUrl) &&
                     !(request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['userId', 'author', 'reactionCount', 'commentCount', 'playCount', 'qualifiedPlayCount', 'reportCount', 'savedCount', 'recommendationState', 'moderation', 'moderationStatus', 'toxicityScore', 'safetyConcernCount', 'reporterIds', 'identityVersion', 'identityPropagationVersion'])));

      allow delete: if isGlobalAdmin();

      match /stats/resonance {
        allow read: if true;
        allow write: if false;
      }

      // --- COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        allow read: if resource == null || canReadArtifact(artifactId);

        // Direct client comment creation is blocked (intents route required)
        allow create: if isGlobalAdmin();

        // Update: Owner can soft-delete (status: DELETED), or artifact owner can update creatorReaction
        allow update: if (isAuth() && isNotPendingDeletion(request.auth.uid) && isActiveSession(request.auth.uid) && (
                      (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('anonymousId', '') == resource.data.get('authorAnonymousId', '') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       request.resource.data.status == 'DELETED' &&
                       request.resource.data.get('artifactId', '') == resource.data.get('artifactId', '')) ||
                      (isArtifactOwner(artifactId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorReaction']))
                    )) || isGlobalAdmin();

        allow delete: if isGlobalAdmin();
      }
    }

    match /artifact_reaction_counts/{artifactId} {
      allow read: if true;
      allow write: if false;
    }

    match /artifact_stats/{artifactId} {
      allow read: if true;
      allow write: if false;
    }

    match /community/{docId} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /artifact_plays/{id} {
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isActiveSession(request.auth.uid) &&
                    request.resource.data.userId == request.auth.uid &&
                    id == "play_" + request.auth.uid + "_" + request.resource.data.sessionIdentity &&
                    request.resource.data.playId == id &&
                    request.resource.data.keys().hasAll(['playId', 'userId', 'artifactId', 'sessionIdentity', 'playbackDurationMs', 'clientOccurredAt', 'serverReceivedAt']) &&
                    request.resource.data.keys().hasOnly(['playId', 'userId', 'artifactId', 'sessionIdentity', 'playbackDurationMs', 'clientOccurredAt', 'serverReceivedAt']) &&
                    request.resource.data.playbackDurationMs is int &&
                    request.resource.data.playbackDurationMs >= 10000 &&
                    request.resource.data.clientOccurredAt is timestamp &&
                    request.resource.data.clientOccurredAt >= request.time - duration.value(30, 'd') &&
                    request.resource.data.clientOccurredAt <= request.time + duration.value(5, 'm') &&
                    request.resource.data.serverReceivedAt is timestamp &&
                    request.resource.data.serverReceivedAt == request.time &&
                    exists(/databases/$(database)/documents/artifacts/$(request.resource.data.artifactId)) &&
                    request.auth.uid != get(/databases/$(database)/documents/artifacts/$(request.resource.data.artifactId)).data.get('userId', '');
      allow update, delete: if false;
    }

    match /usernames/{id} {
      function isValidUsernameId(nameId) {
        return nameId.size() >= 3 &&
               nameId.size() <= 30 &&
               nameId == nameId.lower() &&
               nameId.matches('^[a-z0-9_@.·][a-z0-9_@.· ]+[a-z0-9_@.·]$') &&
               !(nameId in ['admin', 'administrator', 'moderator', 'mod', 'support', 'official', 'artifact', 'system', 'anonymous', 'root']);
      }

      function isUsernameOwnedByProfile(nameId) {
        return existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('anonymousName', '').lower() == nameId;
      }

      allow read: if isAuth();
      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isValidUsernameId(id) &&
                    isUsernameOwnedByProfile(id) &&
                    !('uid' in request.resource.data) &&
                    !('userId' in request.resource.data) &&
                    request.resource.data.reserved == true &&
                    request.resource.data.status == 'ACTIVE' &&
                    request.resource.data.keys().hasOnly(['reserved', 'status', 'createdAt']);
      allow update: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isActiveSession(request.auth.uid) &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('anonymousName', '').lower() == id &&
                    (!('status' in resource.data) || resource.data.status == 'ACTIVE') &&
                    !('uid' in request.resource.data) &&
                    !('userId' in request.resource.data) &&
                    request.resource.data.reserved == true &&
                    request.resource.data.status == 'RETIRED' &&
                    request.resource.data.keys().hasOnly(['reserved', 'status', 'createdAt', 'retiredAt']);
      allow delete: if false;
    }

    // --- PUBLIC PROFILES ---
    match /profiles/{anonymousId} {
      allow read: if true;
      allow write: if false;
    }

    // --- PERSONA MAPPING (Server-Only) ---
    match /persona_mapping/{anonymousId} {
      allow read, write: if false;
    }

    // --- CONSOLIDATED REACTIONS ---
    match /artifact_reactions/{id} {
      allow read: if isGlobalAdmin() ||
                   (isAuth() && (
                     (resource != null && isArtifactOwner(resource.data.artifactId)) ||
                     (resource != null && canReadResonators(resource.data.artifactId))
                   ));

      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isActiveSession(request.auth.uid) &&
                    request.resource.data.authorAnonymousId == getCurrentAnonymousId();

      allow write: if false;
    }

    // --- NOTIFICATIONS & REPORTS ---
    match /notifications/{id} {
      allow read: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '') && isActiveSession(request.auth.uid);
      allow delete: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '') && isNotPendingDeletion(request.auth.uid) && isActiveSession(request.auth.uid);
      allow update: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '') && isNotPendingDeletion(request.auth.uid) && isActiveSession(request.auth.uid) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isActiveSession(request.auth.uid) &&
                    request.resource.data.reporterId == request.auth.uid &&
                    (reportId == request.auth.uid + "_" + request.resource.data.get('artifactId', 'NA') ||
                     reportId == request.auth.uid + "_" + request.resource.data.get('commentId', 'NA') ||
                     reportId.matches("^" + request.auth.uid + "_.*"));
      allow read: if isGlobalAdmin() || (isAuth() && (resource.data.reporterId == request.auth.uid || reportId.matches("^" + request.auth.uid + "_.*")));
      allow write: if isGlobalAdmin();
    }

    match /listening_sessions/{sessionId} {
      allow read: if isAuth() && isActiveSession(request.auth.uid) && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if isAuth() && isNotPendingDeletion(request.auth.uid) && isActiveSession(request.auth.uid) && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && isNotPendingDeletion(request.auth.uid) && isActiveSession(request.auth.uid) && request.resource.data.userId == request.auth.uid;
    }

    match /recommendation_profiles/{uid} {
      allow read: if isOwner(uid) && isActiveSession(uid);
      allow write: if false;
    }

    match /feedback_private/{feedbackId} {
      allow create: if isAuth() &&
                    isNotPendingDeletion(request.auth.uid) &&
                    isActiveSession(request.auth.uid) &&
                    feedbackId.matches("^" + request.auth.uid + "_.*");
      allow read: if false;
    }

    // --- DELETED USERS TOMBSTONES ---
    match /deleted_users/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() &&
                    request.auth.uid == uid &&
                    request.resource.data.state == 'PENDING_DELETION' &&
                    request.resource.data.initiatedAt == request.time &&
                    request.resource.data.keys().hasAll(['state', 'initiatedAt']) &&
                    request.resource.data.keys().hasOnly(['state', 'initiatedAt']);
      allow update, delete: if false;
    }

    // --- SYSTEM CONFIGURATION ---
    match /system/{document=**} {
      allow read, write: if isGlobalAdmin();
    }

    // --- MODERATION ---
    match /moderation_queue/{artifactId} {
      allow read: if isGlobalAdmin();
      allow write: if false;
    }

    match /admin_alerts/{alertId} {
      allow read: if isGlobalAdmin();
      allow write: if false;
    }

    match /moderation_audit_logs/{id} {
      allow read, write: if false;
    }

    // --- INTERNAL LEDGERS & BACKEND GROUPS ---
    match /saved_relationship_states/{id} {
      allow read, write: if false;
    }

    match /saved_notification_groups/{groupId} {
      allow read, write: if false;
    }

    match /idempotency_keys/{key} {
      allow read, write: if false;
    }
  }
}
