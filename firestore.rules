// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{uid}
// Document ID: Firebase Auth UID
// Fields:
//   - anonymousId: string (required) - Publicly visible identifier
//   - anonymousName: string (required) - Display name for anonymous interactions
//   - ... other user profile fields ...
//
// Collection: artifacts/{artifactId}
// Document ID: auto-generated
// Fields:
//   - userId: string (required, immutable) - Creator's UID
//   - isPublic: boolean (required) - Visibility toggle
//   - author: map (required, immutable) - Snapshot of creator's anonymous identity
//   - ... other artifact content fields ...
//
// Collection: artifacts/{artifactId}/comments
// Document ID: auto-generated
// Fields:
//   - artifactId: string (required, immutable) - Parent artifact ID
//   - creatorId: string (required, immutable) - UID of the author
//   - author: map (required, immutable) - Snapshot of author identity
//     - anonymousId: string (required)
//     - name: string (required)
//     - sigil: string (required)
//   - text: string (required, 1-1000 chars) - Comment content
//   - status: string (required, enum: ACTIVE, DELETED, HIDDEN, MODERATED)
//   - createdAt: timestamp (server-generated, immutable)
//   - updatedAt: timestamp (server-generated)
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Business Purpose: Centralized visibility check for Artifacts and their sub-collections.
    // Security Purpose: Single source of truth for read access.
    function canReadArtifact(artifactId) {
      let artifact = get(/databases/$(database)/documents/artifacts/$(artifactId)).data;
      return (artifact.get('isPublic', false) == true ||
             (request.auth != null && artifact.get('userId', '') == request.auth.uid) ||
             isGlobalAdmin());
    }

    // Business Purpose: Determine if the resonators list should be visible based on Artifact policy.
    // Security Purpose: Derives authorization from the authoritative Artifact document.
    function canReadResonators(artifactId) {
      let artifact = get(/databases/$(database)/documents/artifacts/$(artifactId)).data;
      let mode = artifact.get('reactionVisibility', 'APPROXIMATE');
      return canReadArtifact(artifactId) && (mode == 'VISIBLE' || mode == 'APPROXIMATE');
    }

    function isValidComment(data) {
      // MAX_COMMENT_LENGTH must sync with CommentConstants.kt (currently 1000)
      let requiredFields = ['artifactId', 'authorAnonymousId', 'author', 'text', 'status'];
      let optionalFields = ['createdAt', 'updatedAt', 'identityVersion'];
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(requiredFields.concat(optionalFields)) &&
             data.artifactId is string &&
             data.authorAnonymousId is string &&
             data.author is map &&
             data.author.keys().hasAll(['anonymousId', 'name', 'sigil']) &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 1000 &&
             data.status in ['ACTIVE', 'DELETED', 'HIDDEN', 'MODERATED'];
    }

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isArtifactOwner(artifactId) {
      return isAuth() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/published_artifacts/artifacts/$(artifactId)) ||
        // Legacy fallback: check the public document field (Historical Privacy Debt)
        get(/databases/$(database)/documents/artifacts/$(artifactId)).data.get('userId', '') == request.auth.uid
      );
    }

    function getCurrentAnonymousId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId;
    }

    // Business Purpose: Verify if the user has unlocked comments for a specific artifact.
    // Security Purpose: Authoritative check against backend-verified engagement document.
    function isCommentUnlocked(uid, artifactId) {
      let path = /databases/$(database)/documents/users/$(uid)/engagement/$(artifactId);
      return exists(path) && get(path).data.get('isCommentUnlocked', false) == true;
    }

    // Business Purpose: Identify fields that only the backend Cloud Function may modify.
    // Security Purpose: Prevents client-side privilege escalation or manual unlocking.
    function backendFields() {
      return ['isCommentUnlocked', 'unlockTimestamp', 'unlockReason', 'engagementState'];
    }

    // Business Purpose: Determine if user has global administrative rights.
    // Security Purpose: Prevents non-admins from accessing moderation tools.
    // Protected by: admin_rules.test.js
    function isGlobalAdmin() {
      return isAuth() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings).data.get('isAdmin', false) == true;
    }

    function getIdentityMetadata(data) {
      return data.get('identityMetadata', {});
    }

    function getIdentityVersion(meta) {
      return meta.get('identityResetVersion', 0);
    }

    function getCompletedVersion(meta) {
      return meta.get('lastCompletedIdentityVersion', 0);
    }

    function getResetCount(meta) {
      return meta.get('emergencyResetCount', 0);
    }

    // Invariant: Identity versions must be monotonic and consistent.
    function isValidIdentityUpdate(oldData, newData) {
      let oldMeta = getIdentityMetadata(oldData);
      let newMeta = getIdentityMetadata(newData);

      let oldV = getIdentityVersion(oldMeta);
      let newV = getIdentityVersion(newMeta);
      let oldC = getCompletedVersion(oldMeta);
      let newC = getCompletedVersion(newMeta);
      let oldR = getResetCount(oldMeta);
      let newR = getResetCount(newMeta);

      return newV >= oldV &&
             newC >= oldC &&
             newC <= newV &&
             newR >= oldR;
    }

    // --- USERS & PROFILES ---
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow update: if resource != null &&
                   isOwner(uid) &&
                   // Release Hardening: Block modification of privileged fields.
                   // Migration Fix: Allow deletion of legacy fields, block all other modifications (add/change).
                   !request.resource.data.diff(resource.data).changedKeys().hasAny([
                     'isAdmin', 'admin', 'accountStatus', 'email', 'realName', 'fcmToken',
                     'emotionPreferences', 'lastActivityTimestamp', 'softStreakCount', 'lastSeen'
                   ]) &&
                   !request.resource.data.diff(resource.data).addedKeys().hasAny([
                     'isAdmin', 'admin', 'accountStatus', 'email', 'realName', 'fcmToken',
                     'emotionPreferences', 'lastActivityTimestamp', 'softStreakCount', 'lastSeen'
                   ]) &&
                   isValidIdentityUpdate(resource.data, request.resource.data);

      allow create: if isOwner(uid) &&
                    !("isAdmin" in request.resource.data) &&
                    !("admin" in request.resource.data) &&
                    !("accountStatus" in request.resource.data);

      // Consolidated Private Data (Zero-Trust Enforcement)
      match /private/settings {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (
                        (request.method == 'create' &&
                         request.resource.data.get('isAdmin', false) == false &&
                         request.resource.data.get('accountStatus', 'ACTIVE') == 'ACTIVE') ||
                        (request.method == 'update' &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'accountStatus', 'admin']))
                      );
      }

      // Authoritative Report Markers (Cross-Device Suppression)
      // These are created by backend triggers to ensure user-specific hiding.
      // Client is restricted to read-only access to prevent "un-hiding" unsafe content.
      match /private/reports/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /private/ignored_users/{targetId} {
        allow read, write: if isOwner(uid);
      }

      // --- MIGRATION AUDIT (Admin Only) ---
      match /migration_audit/{docId} {
        allow read, write: if false; // Strict isolation from all clients
      }

      match /private/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (document != /settings);
      }

      // Resonance (Privacy Hardened in Phase 6.2.2)
      match /resonance_in/{targetId} { allow read: if isOwner(uid); allow write: if false; }
      match /resonance_out/{targetId} { allow read: if isOwner(uid); allow write: if false; }
      match /followers/{targetId} { allow read: if isOwner(uid); allow write: if false; }
      match /following/{targetId} { allow read: if isOwner(uid); allow write: if false; }

      // Saved Artifacts
      match /savedArtifacts/{artifactId} {
        allow read, write: if isOwner(uid);
      }

      // Engagement (Listen Before You Respond Enforcement)
      match /engagement/{artifactId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
                      !(request.resource.data.keys().hasAny(backendFields()));
        allow update: if isOwner(uid) &&
                      !(request.resource.data.diff(resource.data).affectedKeys().hasAny(backendFields()));
      }
    }

    // --- ARTIFACTS (The Hearth) ---
    match /artifacts/{artifactId} {
      allow read: if resource.data.isPublic == true ||
                    (request.auth != null && resource.data.userId == request.auth.uid) ||
                    isGlobalAdmin();

      function isCreationStatusValid(data) {
        let status = data.get('status', 'PENDING_UPLOAD');
        let audioUrl = data.get('audioUrl', '');
        // Legitimate creation states:
        // 1. New artifact starting upload: PENDING_UPLOAD/DRAFT + No audioUrl
        // 2. Resuming/Checkpoint creation: ACTIVE + audioUrl present
        return (status in ['PENDING_UPLOAD', 'DRAFT'] && audioUrl == '') ||
               (status == 'ACTIVE' && audioUrl != '');
      }

      function isCreationFieldsValid(data) {
        return data.get('playCount', 0) == 0 &&
               data.get('reactionCount', 0) == 0 &&
               data.get('commentCount', 0) == 0 &&
               data.get('reportCount', 0) == 0 &&
               data.get('status', '') in ['ACTIVE', 'PENDING_UPLOAD', 'DRAFT'] &&
               data.get('isDraft', true) == (data.get('status', '') in ['PENDING_UPLOAD', 'DRAFT']);
      }

      allow create: if isAuth() &&
                    // Registry Check: Verify user created the private ownership record first
                    exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/published_artifacts/artifacts/$(artifactId)) &&
                    request.resource.data.author.anonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId &&
                    request.resource.data.author.keys().hasAll(['anonymousId', 'name']) &&
                    request.resource.data.get('identityVersion', 0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityMetadata.get('identityResetVersion', 0) &&
                    isCreationStatusValid(request.resource.data) &&
                    isCreationFieldsValid(request.resource.data);

      function isValidLifecycleTransition(oldData, newData) {
        let oldStatus = oldData.get('status', 'PENDING_UPLOAD');
        let newStatus = newData.get('status', 'PENDING_UPLOAD');
        // Allowed: status unchanged, or PENDING_UPLOAD/DRAFT -> ACTIVE (Publication), or ANY -> DELETED
        return (oldStatus == newStatus) ||
               (oldStatus in ['PENDING_UPLOAD', 'DRAFT'] && newStatus == 'ACTIVE') ||
               (newStatus == 'DELETED');
      }

      allow update: if (resource != null && isGlobalAdmin()) ||
                    (resource != null &&
                     isArtifactOwner(artifactId) &&
                     isValidLifecycleTransition(resource.data, request.resource.data) &&
                     // userId and createdAt are immutable
                     request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
                     request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
                     // audioUrl is immutable once ACTIVE
                     (resource.data.status != 'ACTIVE' || resource.data.audioUrl == request.resource.data.audioUrl) &&
                     !(request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['author', 'reactionCount', 'commentCount', 'playCount', 'reportCount', 'recommendationState', 'moderation', 'moderationStatus', 'toxicityScore', 'safetyConcernCount', 'reporterIds', 'identityVersion'])));

      // Prevent users from hard-deleting the Artifact document to ensure Cloud Function trigger
      allow delete: if isGlobalAdmin();

      match /stats/resonance {
        allow read: if true;
        allow write: if false;
      }

      // --- COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        // Read: Reuse Artifact visibility logic
        allow read: if resource == null || canReadArtifact(artifactId);

        // Create: Authenticated user, matching creatorId and artifactId, valid data
        allow create: if isAuth() &&
                      isValidComment(request.resource.data) &&
                      request.resource.data.authorAnonymousId == getCurrentAnonymousId() &&
                      request.resource.data.artifactId == artifactId &&
                      // Artifact Visibility Boundary (Phase 2 Ch 10 Fix)
                      canReadArtifact(artifactId) &&
                      // Authoritative Unlock Enforcement (Phase 3)
                      // Owners are exempt from the unlock requirement.
                      (isArtifactOwner(artifactId) || isCommentUnlocked(request.auth.uid, artifactId)) &&
                      // Ensure author.anonymousId matches user's anonymousId
                      request.resource.data.author.anonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId &&
                      // Ensure identityVersion matches current user version
                      request.resource.data.get('identityVersion', 0) == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identityMetadata.get('identityResetVersion', 0);

        // Update: Only owner can soft-delete (status: DELETED), or artifact owner can update creatorReaction
        allow update: if isAuth() && (
                      (request.auth.uid == get(/databases/$(database)/documents/persona_mapping/$(resource.data.authorAnonymousId)).data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       request.resource.data.status == 'DELETED' &&
                       request.resource.data.get('artifactId', '') == resource.data.get('artifactId', '')) ||
                      (isArtifactOwner(artifactId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorReaction'])) ||
                      isGlobalAdmin()
                    );

        // Delete: Hard delete only allowed for admins
        allow delete: if isGlobalAdmin();
      }
    }

    match /artifact_reaction_counts/{artifactId} {
      allow read: if true;
      allow write: if false;
    }

    match /artifact_plays/{id} {
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() &&
                    request.resource.data.userId == request.auth.uid &&
                    id.matches("^play_" + request.auth.uid + "_.*");
      allow write: if false;
    }

    match /usernames/{id} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // --- PUBLIC PROFILES (Sanitized) ---
    match /profiles/{anonymousId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }

    // --- PERSONA MAPPING (Private Routing) ---
    match /persona_mapping/{anonymousId} {
      allow read, write: if false; // Strict Server-Only access
    }

    // --- CONSOLIDATED REACTIONS ---
    match /artifact_reactions/{id} {
      allow read: if isGlobalAdmin() ||
                   (isAuth() && (
                     request.auth.uid == get(/databases/$(database)/documents/persona_mapping/$(resource.data.authorAnonymousId)).data.userId ||
                     isArtifactOwner(resource.data.artifactId) ||
                     canReadResonators(resource.data.artifactId)
                   ));

      // AUTHORITATIVE AUTHORIZATION: Validate persona from private record
      allow create: if isAuth() &&
                    request.resource.data.authorAnonymousId == getCurrentAnonymousId();

      allow write: if false;
    }

    // --- NOTIFICATIONS & REPORTS ---
    match /notifications/{id} {
      allow read: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '');
      allow delete: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '');
      allow update: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '') &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuth() &&
                    request.resource.data.reporterId == request.auth.uid &&
                    reportId == request.auth.uid + "_" + request.resource.data.artifactId;
      allow read: if isGlobalAdmin() || (isAuth() && reportId.matches("^" + request.auth.uid + "_.*"));
      allow write: if isGlobalAdmin();
    }

    match /listening_sessions/{sessionId} {
      allow read, write: if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /isolation_test/repro_doc {
      allow read: if isAuth();
    }

    match /recommendation_profiles/{uid} {
      allow read: if isOwner(uid);
    }

    match /feedback_private/{feedbackId} {
      allow create: if isAuth() &&
                    feedbackId.startsWith(request.auth.uid + "_");
      allow read: if false; // Private to backend only
    }

    // --- MODERATION ---
    match /moderation_queue/{artifactId} {
      allow read: if isGlobalAdmin();
      allow write: if false;
    }

    match /moderation_audit_logs/{id} {
      allow read, write: if false; // Internal Audit Only (Cloud Functions)
    }
  }
}
