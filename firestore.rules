// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{uid}
// Document ID: Firebase Auth UID
// Fields:
//   - anonymousId: string (required) - Publicly visible identifier
//   - anonymousName: string (required) - Display name for anonymous interactions
//   - ... other user profile fields ...
//
// Collection: artifacts/{artifactId}
// Document ID: auto-generated
// Fields:
//   - userId: string (required, immutable) - Creator's UID
//   - isPublic: boolean (required) - Visibility toggle
//   - author: map (required, immutable) - Snapshot of creator's anonymous identity
//   - ... other artifact content fields ...
//
// Collection: artifacts/{artifactId}/comments
// Document ID: auto-generated
// Fields:
//   - artifactId: string (required, immutable) - Parent artifact ID
//   - creatorId: string (required, immutable) - UID of the author
//   - author: map (required, immutable) - Snapshot of author identity
//     - anonymousId: string (required)
//     - name: string (required)
//     - sigil: string (required)
//   - text: string (required, 1-1000 chars) - Comment content
//   - status: string (required, enum: ACTIVE, DELETED, HIDDEN, MODERATED)
//   - createdAt: timestamp (server-generated, immutable)
//   - updatedAt: timestamp (server-generated)
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Business Purpose: Centralized visibility check for Artifacts and their sub-collections.
    // Security Purpose: Single source of truth for read access.
    function canReadArtifact(artifactId) {
      let artifact = get(/databases/$(database)/documents/artifacts/$(artifactId)).data;
      return artifact.get('isPublic', false) == true ||
             (request.auth != null && artifact.get('userId', '') == request.auth.uid) ||
             isGlobalAdmin();
    }

    function isValidComment(data) {
      // MAX_COMMENT_LENGTH must sync with CommentConstants.kt (currently 1000)
      return data.keys().hasAll(['artifactId', 'creatorId', 'author', 'text', 'status']) &&
             data.artifactId is string &&
             data.creatorId is string &&
             data.author is map &&
             data.author.keys().hasAll(['anonymousId', 'name', 'sigil']) &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 1000 &&
             data.status in ['ACTIVE', 'DELETED', 'HIDDEN', 'MODERATED'];
    }

    // --- HELPER FUNCTIONS ---
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Business Purpose: Determine if user has global administrative rights.
    // Security Purpose: Prevents non-admins from accessing moderation tools.
    // Protected by: admin_rules.test.js
    function isGlobalAdmin() {
      return isAuth() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)/private/settings).data.get('isAdmin', false) == true;
    }

    function getIdentityMetadata(data) {
      return data.get('identityMetadata', {});
    }

    function getIdentityVersion(meta) {
      return meta.get('identityResetVersion', 0);
    }

    function getCompletedVersion(meta) {
      return meta.get('lastCompletedIdentityVersion', 0);
    }

    function getResetCount(meta) {
      return meta.get('emergencyResetCount', 0);
    }

    // Invariant: Identity versions must be monotonic and consistent.
    function isValidIdentityUpdate(oldData, newData) {
      let oldMeta = getIdentityMetadata(oldData);
      let newMeta = getIdentityMetadata(newData);

      let oldV = getIdentityVersion(oldMeta);
      let newV = getIdentityVersion(newMeta);
      let oldC = getCompletedVersion(oldMeta);
      let newC = getCompletedVersion(newMeta);
      let oldR = getResetCount(oldMeta);
      let newR = getResetCount(newMeta);

      return newV >= oldV &&
             newC >= oldC &&
             newC <= newV &&
             newR >= oldR;
    }

    // --- USERS & PROFILES ---
    match /users/{uid} {
      allow read: if isOwner(uid) ||
                   (request.auth != null && resource != null && !resource.data.keys().hasAny(['email', 'displayName', 'realName', 'fcmToken']));

      allow update: if resource != null &&
                   request.auth != null &&
                   request.auth.uid == uid &&
                   !(request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                     .hasAny(['isAdmin', 'admin', 'accountStatus', 'email', 'realName'])) &&
                   isValidIdentityUpdate(resource == null ? {} : resource.data, request.resource.data);

      allow create: if isOwner(uid) &&
                    !("isAdmin" in request.resource.data) &&
                    !("admin" in request.resource.data) &&
                    !("accountStatus" in request.resource.data);

      // Consolidated Private Data (Zero-Trust Enforcement)
      match /private/settings {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (
                        (request.method == 'create' &&
                         request.resource.data.get('isAdmin', false) == false &&
                         request.resource.data.get('accountStatus', 'ACTIVE') == 'ACTIVE') ||
                        (request.method == 'update' &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'accountStatus', 'admin']))
                      );
      }

      match /private/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (document != /settings);
      }

      // Resonance
      match /resonance_in/{targetId} { allow read: if isAuth(); allow write: if false; }
      match /resonance_out/{targetId} { allow read: if isAuth(); allow write: if false; }
      match /followers/{targetId} { allow read: if isAuth(); allow write: if false; }
      match /following/{targetId} { allow read: if isAuth(); allow write: if false; }

      match /savedArtifacts/{artifactId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- ARTIFACTS (The Hearth) ---
    match /artifacts/{artifactId} {
      allow read: if resource.data.isPublic == true ||
                    (request.auth != null && resource.data.userId == request.auth.uid) ||
                    isGlobalAdmin();

      allow create: if isAuth() &&
                    request.resource.data.get('userId', '') == request.auth.uid &&
                    request.resource.data.author.anonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId &&
                    request.resource.data.author.keys().hasAll(['anonymousId', 'name']);

      allow update: if (resource != null && isGlobalAdmin()) ||
                    (resource != null &&
                     request.auth != null &&
                     request.auth.uid == resource.data.get('userId', '') &&
                     !(request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                       .hasAny(['reactionCount'])));

      // Prevent users from hard-deleting the Artifact document to ensure Cloud Function trigger
      allow delete: if isGlobalAdmin();

      match /stats/resonance {
        allow read: if true;
        allow write: if false;
      }

      // --- COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        // Read: Reuse Artifact visibility logic
        allow read: if resource == null || canReadArtifact(artifactId);

        // Create: Authenticated user, matching creatorId and artifactId, valid data
        allow create: if isAuth() &&
                      isValidComment(request.resource.data) &&
                      request.resource.data.creatorId == request.auth.uid &&
                      request.resource.data.artifactId == artifactId &&
                      // Ensure author.anonymousId matches user's anonymousId
                      request.resource.data.author.anonymousId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.anonymousId;

        // Update: Only owner can soft-delete (status: DELETED)
        allow update: if isAuth() &&
                      resource.data.creatorId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                      request.resource.data.status == 'DELETED' &&
                      // Ensure immutable fields didn't change
                      request.resource.data.creatorId == resource.data.creatorId &&
                      request.resource.data.artifactId == resource.data.artifactId;

        // Delete: Hard delete not allowed
        allow delete: if false;
      }
    }

    match /artifact_reaction_counts/{artifactId} {
      allow read: if true;
      allow write: if false;
    }

    // --- IDENTITY & ANTI-ENUMERATION ---
    match /usernames/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // --- CONSOLIDATED REACTIONS ---
    match /artifact_reactions/{id} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.artifactOwnerId == request.auth.uid
      );
      allow write: if false;
    }

    // --- NOTIFICATIONS & REPORTS ---
    match /notifications/{id} {
      allow read: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '');
      allow delete: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '');
      allow update: if request.auth != null && resource != null && request.auth.uid == resource.data.get('userId', '') &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create: if false;
    }

    match /reports/{id} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read, write: if isGlobalAdmin();
    }

    match /listening_sessions/{sessionId} {
      allow read, write: if isAuth() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /recommendation_profiles/{uid} {
      allow read: if isOwner(uid);
    }
  }
}
