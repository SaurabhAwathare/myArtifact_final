rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Checks if the artifact is public and active in Firestore
    function isPublicArtifact(draftId) {
      let artifact = firestore.get(/databases/(default)/documents/artifacts/$(draftId)).data;
      return artifact.isPublic == true && artifact.status == "ACTIVE";
    }

    // 1. Artifacts: Flat structure with userId prefix (e.g., artifacts/UID_ID.m4a)
    match /artifacts/{fileName} {
      // Allow read if:
      // 1. User is the owner (UID prefix match)
      // 2. Artifact is public and active in Firestore (verified via draftId metadata)
      allow read: if request.auth != null && (
        fileName.matches("^" + request.auth.uid + "_.*") ||
        (resource.metadata != null && resource.metadata.draftId != null && isPublicArtifact(resource.metadata.draftId))
      );
      allow write: if request.auth != null && fileName.matches("^" + request.auth.uid + "_.*");
    }

    // 2. Transcripts: Flat structure with userId prefix (e.g., transcripts/UID_ID.json)
    match /transcripts/{fileName} {
      // Mirror authorization from artifacts for consistency
      allow read: if request.auth != null && (
        fileName.matches("^" + request.auth.uid + "_.*") ||
        (resource.metadata != null && resource.metadata.draftId != null && isPublicArtifact(resource.metadata.draftId))
      );
      allow write: if request.auth != null && fileName.matches("^" + request.auth.uid + "_.*");
    }

    // 3. Backups: Folder structure (backups/UID/file.enc)
    match /backups/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default: Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
