<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the Room database -->
        <include domain="database" path="artifact_db"/>

        <!-- Include selective DataStore preferences -->
        <include domain="file" path="datastore/settings.preferences_pb"/>
        <include domain="file" path="datastore/playback_settings.preferences_pb"/>
        <include domain="file" path="datastore/user_session.preferences_pb"/>
        <include domain="file" path="datastore/onboarding_prefs.preferences_pb"/>
        <include domain="file" path="datastore/db_encryption_prefs.preferences_pb"/>

        <!-- Sensitive voice recordings and metadata are excluded by omission -->
    </cloud-backup>

    <device-transfer>
        <!-- Device transfer includes all preferences for a seamless move -->
        <include domain="database" path="artifact_db"/>
        <include domain="file" path="datastore/"/>

        <!-- Audio and metadata are excluded by omission in device-transfer -->
    </device-transfer>
</data-extraction-rules>