<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Include the main Room database for same-device recovery -->
    <include domain="database" path="artifact_db"/>

    <!-- Include DataStore configurations for settings and non-sensitive session data -->
    <!-- Using specific files to ensure we don't accidentally include future sensitive material -->
    <include domain="file" path="datastore/settings.preferences_pb"/>
    <include domain="file" path="datastore/playback_settings.preferences_pb"/>
    <include domain="file" path="datastore/user_session.preferences_pb"/>
    <include domain="file" path="datastore/onboarding_prefs.preferences_pb"/>
    <include domain="file" path="datastore/db_encryption_prefs.preferences_pb"/>

    <!-- Sensitive voice data and metadata are excluded by omission (Whitelist Mode) -->
</full-backup-content>