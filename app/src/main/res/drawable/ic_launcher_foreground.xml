<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Atmospheric Aura -->
    <path android:pathData="M54,54m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0" android:color="#66FFC76A" />
                <item android:offset="1" android:color="#00FFC76A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The Hearth (Core) -->
    <path android:pathData="M54,54m-27,0a27,27 0,1 1,54 0a27,27 0,1 1,-54 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="27"
                android:type="radial">
                <item android:offset="0" android:color="@color/gold_aura_400" />
                <item android:offset="0.5" android:color="#B3FFC76A" />
                <item android:offset="1" android:color="#00FFC76A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Wick Glow -->
    <path
        android:pathData="M54,54m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0"
        android:strokeWidth="1.5"
        android:strokeColor="#33FAF7F2" />

</vector>